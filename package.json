{
  "name": "sha-li-tao-da-hong",
  "version": "1.0.0",
  "private": true,
  "description": "《沙里淘大红》微信小游戏 MVP v1.0（流沙抽板盲盒 + 数据校验管线）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:wx": "tsc --noEmit && node scripts/build-wx.mjs",
    "upload:wx": "node scripts/upload-wx.mjs",
    "test:ac": "node scripts/verify-mvp-ac.mjs",
    "validate": "node tools/validate-content.js --report",
    "validate:fast": "node tools/validate-content.js --fast",
    "test:dedupe": "node tools/test-dedupe.js",
    "render:levels": "node tools/render-levels.js",
    "gen:art-doc": "node tools/gen-art-doc.js",
    "gen:assets": "node scripts/generate_assets.js",
    "gen:bgm": "node scripts/compose_bgm.mjs",
    "compress:assets": "python3 scripts/compress_assets.py assets/ --check-budget",
    "registry": "node tools/registry.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "miniprogram-ci": "^2.1.31",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
