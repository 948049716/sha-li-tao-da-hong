{
  "$comment": "《沙里淘大红》听觉（WebAudio 合成 + 音频资产包）与微信触觉震动配置文件（v1.0）",
  "version": 1,
  "budgets": {
    "mainAudioMaxKB": 250,
    "subpackageAudioMaxKB": 1500,
    "maxConcurrentSfx": 6
  },
  "mixer": {
    "bgmDefaultGain": 0.32,
    "bgmAppraisalDuckGain": 0.08,
    "bgmDuckFadeMs": 200,
    "bgmRestoreFadeMs": 500,
    "bgmFadeInMs": 1800,
    "bgmSandFlowDuckRatio": 0.3,
    "masterSfxGain": 0.85
  },
  "webAudioSynths": [
    {
      "synthId": "synth_sand_asmr",
      "title": "流沙塌方与漏斗吸入实时白噪音合成器",
      "type": "loop_white_noise_bandpass",
      "filterType": "bandpass",
      "freqRangeHz": [1800, 3600],
      "qFactor": 1.8,
      "maxGain": 0.28,
      "flowFullScaleParticlesPerFrame": 35,
      "smoothingTimeConstantSec": 0.06,
      "note": "随每帧活跃下落+吸入沙粒数动态平滑调制滤波器中心频率与 GainNode 音量，零包体占用"
    },
    {
      "synthId": "synth_gold_sand_shimmer",
      "title": "黄金狂热沙高频星尘晶铃合成器",
      "type": "arpeggio_sine_chime",
      "notesHz": [1318.51, 1567.98, 1975.53, 2637.02],
      "decayMs": 95,
      "cooldownMs": 70,
      "maxGain": 0.14,
      "note": "吸入 ColorID=5 黄金狂热沙或穿戴彩虹吸沙特效时叠加清脆晶铃泛音"
    },
    {
      "synthId": "synth_bucket_pentatonic",
      "title": "连续进沙五声音阶递升反馈合成器",
      "type": "pentatonic_triangle_pluck",
      "scaleHz": [523.25, 587.33, 659.25, 783.99, 880.00, 1046.50],
      "stepEveryPct": 16,
      "decayMs": 110,
      "cooldownMs": 60,
      "maxGain": 0.18,
      "note": "单只接沙桶每上涨约 16% 水位跳升一阶五声音符（C5→D5→E5→G5→A5→C6），强化灌满爽感"
    },
    {
      "synthId": "synth_fallback_tap",
      "title": "音频分包未就绪时的合成降级音效器",
      "type": "procedural_fallback",
      "freqSweepHz": [220, 880],
      "decayMs": 140,
      "maxGain": 0.22,
      "note": "极弱网下 subpackages/audio 尚未加载完毕时，为开箱揭晓/撤回提供零延迟合成音兜底"
    }
  ],
  "hapticPatterns": {
    "NONE": [],
    "LIGHT_SINGLE": [{ "delayMs": 0, "type": "light" }],
    "MEDIUM_SINGLE": [{ "delayMs": 0, "type": "medium" }],
    "HEAVY_SINGLE": [{ "delayMs": 0, "type": "heavy" }],
    "RED_DOUBLE_HEAVY": [
      { "delayMs": 0, "type": "heavy" },
      { "delayMs": 160, "type": "heavy" }
    ],
    "HEARTBEAT_PULSE": [
      { "delayMs": 0, "type": "light" },
      { "delayMs": 550, "type": "light" },
      { "delayMs": 1050, "type": "medium" },
      { "delayMs": 1500, "type": "medium" },
      { "delayMs": 1900, "type": "heavy" }
    ]
  },
