    },
    {
      "synthId": "synth_gold_sand_shimmer",
      "title": "黄金狂热沙星尘风铃合成器",
      "type": "arpeggio_sine_chime",
      "notesHz": [
        1567.98,
        1760,
        1975.53,
        2349.32
      ],
      "decayMs": 105,
      "cooldownMs": 70,
      "maxGain": 0.13,
